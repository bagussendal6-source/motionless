{
  "name": "motionless",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MotionLess: a motion-design editor that Claude Code drives over MCP.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch server/index.ts\" \"vite\"",
    "server": "node server/index.ts",
    "web": "vite",
    "mcp": "node mcp/index.ts",
    "build": "vite build",
    "start": "vite build && NODE_ENV=production node server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  }
}
